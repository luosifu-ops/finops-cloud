# 财税企管云 · 构建上下文排除（避免密钥/垃圾打进生产镜像）
# 项目根即生产镜像构建上下文（docker-compose build context: ..）

# —— 密钥 / 环境变量（绝不能进镜像） ——
.env
*.env
backend/.env
deploy/prod/.env

# —— 数据库 / 媒体 / 本地数据 ——
*.sqlite3
db.sqlite3
media/
backend/media/

# —— 前端源码与依赖（镜像只用 backend/spa 里的构建产物，不复制源码） ——
web/
miniprogram/
docs/
logs/
.workbuddy/

# —— 依赖缓存 / 字节码 ——
node_modules/
**/node_modules/
__pycache__/
*.py[cod]

# —— 编辑器 / 系统 ——
.DS_Store
.idea/
.vscode/
