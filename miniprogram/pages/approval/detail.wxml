<!-- 审批详情 -->
<view class="page-pad">
  <view class="card">
    <view class="row-title" style="font-size:36rpx;">{{a.title || a.biz_type_name || '审批单'}}</view>
    <view class="row" style="border:none;"><view class="row-main"><view class="row-title">类型</view></view><text>{{a.biz_type_name||'—'}}</text></view>
    <view class="row" style="border:none;"><view class="row-main"><view class="row-title">申请人</view></view><text>{{a.applicant_name||'—'}}</text></view>
    <view class="row" style="border:none;"><view class="row-main"><view class="row-title">状态</view></view><text class="tag {{a.status==='APPROVED'?'tag-green':(a.status==='REJECTED'?'tag-orange':'tag-blue')}}">{{a.status_name}}</text></view>
    <view class="row" style="border:none;"><view class="row-main"><view class="row-title">内容</view></view><text>{{a.content||'—'}}</text></view>
  </view>

  <view class="section-title"><text class="bar"></text>审批节点</view>
  <view class="card" wx:for="{{a.steps}}" wx:key="id">
    <view class="row" style="border:none;">
      <view class="row-main">
        <view class="row-title">第{{item.step}}级 · {{item.approver_name||'—'}}</view>
        <view class="row-sub">{{item.remark||'—'}} · {{item.handled_at?item.handled_at:''}}</view>
      </view>
      <text class="tag {{item.status==='APPROVED'?'tag-green':(item.status==='REJECTED'?'tag-orange':'tag-gray')}}">{{item.status_name}}</text>
    </view>
  </view>

  <block wx:if="{{a.status==='PENDING'}}">
    <view class="card">
      <view class="section-title"><text class="bar"></text>审批意见</view>
      <textarea class="input" value="{{remark}}" bindinput="onRemark" placeholder="填写审批意见（选填）"/>
    </view>
    <view class="row" style="border:none;">
      <view class="btn btn-green btn-block" style="width:48%;" bindtap="handle" data-act="approve">同意</view>
      <view class="btn btn-pink btn-block" style="width:48%;" bindtap="handle" data-act="reject">驳回</view>
    </view>
  </block>
</view>
