<!-- 详情 -->
<view class="page-pad">
  <!-- 资料文章 -->
  <block wx:if="{{type!=='profile'}}">
    <view class="card">
      <view class="row-title" style="font-size:36rpx;">{{item.title}}</view>
      <view class="row-sub" style="margin:10rpx 0 20rpx;">{{item.category_name || item.knowledge_category_name || ''}} · {{item.level_name || ''}}</view>
      <view class="article">{{item.content || '暂无内容'}}</view>
    </view>
    <view class="btn btn-green btn-block" wx:if="{{type==='regulation' && !item.acked}}" bindtap="ack">确认已读</view>
    <view class="btn btn-green btn-block" wx:if="{{type==='knowledge' && !item.finished}}" bindtap="learn">标记已学完</view>
    <view class="btn btn-ghost btn-block" wx:if="{{type==='regulation' && item.acked}}">已读确认 ✓</view>
    <view class="btn btn-ghost btn-block" wx:if="{{type==='knowledge' && item.finished}}">已完成学习 ✓</view>
  </block>

  <!-- 入职资料 -->
  <block wx:if="{{type==='profile'}}">
    <view class="card" wx:if="{{item}}">
      <view class="row"><view class="row-main"><view class="row-title">姓名</view></view><text>{{item.name || '—'}}</text></view>
      <view class="row"><view class="row-main"><view class="row-title">手机</view></view><text>{{item.phone || '—'}}</text></view>
      <view class="row"><view class="row-main"><view class="row-title">部门</view></view><text>{{item.department_name || '—'}}</text></view>
      <view class="row"><view class="row-main"><view class="row-title">岗位</view></view><text>{{item.position || '—'}}</text></view>
      <view class="row"><view class="row-main"><view class="row-title">状态</view></view><text class="tag">{{item.status_name || '草稿'}}</text></view>
    </view>
    <view class="card" wx:if="{{!item}}">
      <view class="empty">你还没有提交入职资料</view>
    </view>
    <view class="btn btn-pink btn-block" bindtap="submitProfile">提交入职资料</view>
  </block>
</view>
