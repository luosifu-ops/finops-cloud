<!-- 投放明细 -->
<view class="page-pad">
  <scroll-view scroll-x class="seg" style="white-space:nowrap;">
    <view class="seg-item {{pid===''?'seg-on':''}}" style="display:inline-block;min-width:140rpx;" bindtap="filter" data-p="">全部</view>
    <view class="seg-item {{pid==item.id?'seg-on':''}}" style="display:inline-block;min-width:160rpx;" wx:for="{{platforms}}" wx:key="id" bindtap="filter" data-p="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="row" style="border:none;">
      <view class="row-main">
        <view class="row-title">{{item.date}} · {{item.platform_name || ''}}</view>
        <view class="row-sub">花费¥{{item.cost||0}} · 线索{{item.lead_count||0}} · 有效{{item.valid_lead||0}} · 成交{{item.deal_count||0}}</view>
      </view>
      <text class="tag tag-green">ROI {{item.roi||0}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">暂无数据</view>
</view>
