<view class="page-pad">
  <view class="hero">
    <view class="hero-title">招商中心</view>
    <view class="hero-sub">政策与素材一站式管理</view>
  </view>
  <view class="grid" style="margin-top:20rpx;">
    <view class="grid-item" wx:for="{{cards}}" wx:key="label" bindtap="go" data-url="{{item.url}}">
      <view class="grid-icon" style="background:{{item.color}}">{{item.icon}}</view>
      <view class="grid-label">{{item.label}}</view>
    </view>
  </view>
  <view class="card" wx:for="{{cards}}" wx:key="label" bindtap="go" data-url="{{item.url}}" style="display:flex;align-items:center;">
    <view class="row-main">
      <view class="row-title">{{item.label}}</view>
      <view class="row-sub">{{item.desc}}</view>
    </view>
    <text class="tag tag-blue">进入</text>
  </view>
</view>
