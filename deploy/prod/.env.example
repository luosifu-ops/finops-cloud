# 财税企管云 · 生产环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# 启动：docker compose -f deploy/prod/docker-compose.yml --env-file deploy/prod/.env up -d --build

# —— 域名与站点 —— #
# 你的备案域名（已解析 A 记录到服务器 IP），多个用逗号分隔
SITE_DOMAIN=finops.your-company.com
ALLOWED_HOSTS=finops.your-company.com,www.finops.your-company.com
# 前端跨域白名单（一般与域名一致）
CORS_ALLOWED_ORIGINS=https://finops.your-company.com

# —— 品牌（私有化白标，卖给同行时按客户改；不填保持默认「财税企管云」） —— #
BRAND_NAME=财税企管云
BRAND_LOGO_CHAR=财
BRAND_SUBTITLE=代账公司 · 一体化智能管理平台
# 备案号（备案通过后填写，前端页脚展示；留空不显示）
ICP_BEIAN=
POLICE_BEIAN=

# —— 密钥（务必强随机，命令生成：openssl rand -hex 50） —— #
DJANGO_SECRET_KEY=__CHANGE_ME_TO_A_LONG_RANDOM_STRING__
# PostgreSQL 密码（请自定义）
DB_PASSWORD=__CHANGE_ME_STRONG_DB_PASSWORD__
POSTGRES_DB=finops
POSTGRES_USER=finops

# —— 可选：真实第三方能力（留空则走演示模式） —— #
# 大模型（DeepSeek / 通义等 OpenAI 兼容端点）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 微信开放平台（PC 扫码登录）
WX_OPEN_APPID=
WX_OPEN_SECRET=
# 微信支付（真实收款）
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_ENABLED=False
# 企业工商查询（二选一即可激活真实数据；天眼查单 Key 即可，企查查需 Key+Secret 签名）
# 天眼查开放平台 AppKey（Authorization: token 方式，最易接入）
TIANYANCHA_API_KEY=
# 企查查开放平台 AppKey + AppSecret（token = md5(key+random+secret)，需同时配置 SECRET）
QICHACHA_API_KEY=
QICHACHA_SECRET=
# 抖音/短视频对标数据：第三方数据商（蝉妈妈/飞瓜/巨量算数）无免费公开 API，
# 需自建代理或购买。填好下面端点+Key 后 douyin_account 会真实请求（约定返回字段见 README），失败回退演示。
DOUYIN_API_BASE=
DOUYIN_API_KEY=
# 云账房：SaaS 无公开 API，需官方登录授权；本系统保留演示数据 + 官方入口跳转
YUNZHANGFANG_API_KEY=
